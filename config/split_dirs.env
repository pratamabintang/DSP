# Example: train/val/test stored in different places on the drive.
# Use with: CONFIG=config/split_dirs.env bash run_landslide_colab.sh all
: "${TRAIN_DIR:=/content/drive/MyDrive/project/3.TRAINING}"
: "${VAL_DIR:=/content/drive/MyDrive/project/4.VALIDATION}"
: "${TEST_DIR:=/content/drive/MyDrive/project/5.TESTING}"
: "${BLACKLIST:=/content/drive/MyDrive/project/black_list.txt}"
: "${LOG_DIR:=/content/drive/MyDrive/project/runs}"
: "${EXP_PREFIX:=baseline}"
source "$(dirname "${BASH_SOURCE[0]}")/baseline.env"   # remaining baseline hyper-parameters
