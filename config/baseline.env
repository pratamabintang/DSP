# Baseline: DSPNet, 1-way 1-shot, RGB 256x256, ResNet-101 (COCO init), seed 1234.
# Values use ': "${VAR:=default}"' so anything exported/passed on the command line still wins.
# Used by: bash run_landslide_colab.sh {setup|train|test|all}   (CONFIG=config/baseline.env by default)

# --- data (edit for your Drive layout; leave split dirs empty to use DATA_DIR/<split>) ---
: "${DATA_DIR:=/content/drive/MyDrive/landslide}"
: "${TRAIN_DIR:=}"
: "${VAL_DIR:=}"
: "${TEST_DIR:=}"
: "${BLACKLIST:=}"            # empty = $DATA_DIR/black_list.txt, 'none' = disabled
: "${LOG_DIR:=/content/drive/MyDrive/dspnet_runs}"

# --- training ---
: "${SEED:=1234}"
: "${NSTEP:=50000}"
: "${MAX_ITER:=1000}"
: "${SNAPSHOT_INTERVAL:=5000}"
: "${LR:=0.001}"
: "${DECAY:=0.95}"
: "${INPUT_SIZE:=512}"
: "${PROTO_GRID:=8}"
: "${MIN_FG:=64}"
: "${USE_WCE:=True}"
: "${NWORKER:=2}"
: "${EXP_PREFIX:=baseline}"

# --- testing ---
: "${EVAL_SPLIT:=test}"
: "${N_EVAL_EPISODES:=None}"
: "${VAL_WSIZE:=2}"
